{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppConfig": {
    "UseHttpsRedirection": true
  },
  "JwtConfig": {
    "Issuer": "alfred_backend",
    "Audience": "alfred_backend",
    "ExpirationTime": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
